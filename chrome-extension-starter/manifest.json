{
  "manifest_version": 3,
  "name": "Chrome Extension Starter",
  "version": "1.0",
  "description": "A basic starter template for Chrome Extension MV3.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ]
}
